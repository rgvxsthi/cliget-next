{
  "manifest_version": 3,
  "name": "cliget-next",
  "version": "3.0.2",
  "description": "Download login-protected files from the command line with curl, wget, aria2 or a download queue.",
  "homepage_url": "https://github.com/rgvxsthi/cliget-next",
  "icons": {
    "16": "icons/cliget-next-16.png",
    "32": "icons/cliget-next-32.png",
    "48": "icons/cliget-next-48.png",
    "96": "icons/cliget-next-96.png",
    "128": "icons/cliget-next-128.png"
  },
  "permissions": ["webRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "cliget-next",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/cliget-next-dark-16.png",
      "32": "icons/cliget-next-dark-32.png"
    },
    "theme_icons": [
      {
        "dark": "icons/cliget-next-dark-16.png",
        "light": "icons/cliget-next-light-16.png",
        "size": 16
      },
      {
        "dark": "icons/cliget-next-dark-32.png",
        "light": "icons/cliget-next-light-32.png",
        "size": 32
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cliget-next@rgvxsthi.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "minimum_chrome_version": "120",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
